# Public configuration placeholders for FinanceApp.
# Copy to .env for local development. Never commit real secrets.
# Only public/publishable values may live here. Service-role keys,
# signing keys, OAuth client secrets, and provider secrets belong in
# Supabase/EAS/CI secret stores, never in .env files or the bundle.

# Runtime environment. One of: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project URL (public).
# HTTPS is required in preview and production; HTTP is allowed only
# for localhost in development (Supabase CLI default port is 54321).
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase publishable/anon key (public, safe for the mobile bundle).
# Must be a publishable/anon key; service-role (JWT role=service_role)
# and secret (sb_secret_*) keys are rejected by validation.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# EAS Update channel; must match EXPO_PUBLIC_APP_ENV:
# development -> development, preview -> preview, production -> production.
EXPO_PUBLIC_EAS_UPDATE_CHANNEL=development