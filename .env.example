# Public configuration placeholders for FinanceApp.
# Copy to .env for local development. Never commit real secrets.
# Only public/publishable values may live here. Service-role keys,
# signing keys, OAuth client secrets, and provider secrets belong in
# Supabase/EAS/CI secret stores, never in .env files or the bundle.

# Expo runtime environment: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project URL (public)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase publishable anon key (public, safe for the mobile bundle)
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# EAS Update channel used by the active build
EXPO_PUBLIC_EAS_UPDATE_CHANNEL=development
